[Unit]
Description=xinshi-admin backend service
Documentation=https://github.com/example/xinshi-admin
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=xinshi
Group=xinshi
WorkingDirectory=/opt/xinshi-admin

# 环境变量
Environment="SPRING_PROFILES_ACTIVE=live"
Environment="SERVER_PORT=8080"
Environment="HEAP_MIN=256m"
Environment="HEAP_MAX=4g"
Environment="XINSHI_CONFIG_DIR=/opt/xinshi-admin/config"

# 启动脚本要求使用 nohup 后台启动，然后通过 PID 文件检测
# startup.sh 会在启动后写入 app.pid，systemd 通过 PIDFile 追踪
PIDFile=/opt/xinshi-admin/app.pid
ExecStart=/bin/bash /opt/xinshi-admin/startup.sh start
ExecStop=/bin/bash /opt/xinshi-admin/startup.sh stop
ExecReload=/bin/bash /opt/xinshi-admin/startup.sh restart

# ======== 自动重启配置 ========
# 任何退出原因都自动重启
Restart=always
# 重启前等待 10 秒（给端口释放、资源清理留时间）
RestartSec=10
# 5 分钟内最多重启 5 次，超过则停止重启（防止 crash loop 耗尽资源）
StartLimitBurst=5
StartLimitInterval=300

# 标准输出和错误输出重定向到日志
StandardOutput=append:/opt/xinshi-admin/logs/systemd-stdout.log
StandardError=append:/opt/xinshi-admin/logs/systemd-stderr.log

# 超时配置
# 启动超时：120 秒（Spring Boot 启动较慢时需要足够时间）
TimeoutStartSec=120
# 停止超时：60 秒（给优雅关闭足够时间）
TimeoutStopSec=60

# 如果进程被 OOM Killer 杀掉，systemd 也能感知并重启
# Restart=always 已覆盖此场景

# 安全加固（可选，根据实际环境调整）
# NoNewPrivileges=yes
# ProtectSystem=strict
# ProtectHome=yes
# ReadWritePaths=/opt/xinshi-admin/logs /opt/xinshi-admin/config /opt/data/xinshi/results
# PrivateTmp=yes

[Install]
WantedBy=multi-user.target
